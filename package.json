{
  "name": "thy-weaver",
  "type": "module",
  "version": "0.0.0",
  "template-version": "0.3.1-beta",
  "description": "A starter template for a modern Twine development workflow",
  "scripts": {
    "dev-watch": "bun cross-env NODE_ENV=development bun run --watch --no-clear-screen ./build.ts & bun run ./.build/dev_server.ts",
    "prod": "bun cross-env NODE_ENV=production bun run ./build.ts"
  },
