{
	"name": "thy-weaver",
	"type": "module",
	"version": "0.0.0",
	"template-version": "0.3.1-beta",
	"description": "A starter template for a modern Twine development workflow",
	"scripts": {
		"serve": " bun run --bun rapidpreview --port 3000 --path ./dist --file ./index.html",
		"generate-css-module-types": "bun run --bun tcm src -w -c",
		"dev-watch": "bun run dev-watch:no-server & bun run serve",
		"dev-watch:no-server": "cross-env NODE_ENV=development bun run --no-clear-screen ./build.ts & bun run generate-css-module-types",
		"prod": "cross-env NODE_ENV=production bun run ./build.ts",
		"check-types": "tsc"
	},
	"template-author": "Iceman8911",
	"license": "MIT",
	"template-license": "MIT",
	"devDependencies": {
		"@parcel/watcher": "^2.5.1",
		"@types/bun": "^1.2.5",
		"@types/fs-extra": "^11.0.4",
		"@types/twine-sugarcube": "^2.37.2",
		"cross-env": "^7.0.3",
		"fs-extra": "^11.3.0",
		"lightningcss": "^1.29.3",
		"rapid-preview": "^1.0.4",
		"sass-embedded": "^1.85.1",
		"tweenode": "^0.2.9",
		"typed-css-modules": "^0.9.1",
		"typescript": "^5.8.2"
	},
	"dependencies": {
		"@ctrl/tinycolor": "^4.1.0",
		"lz-string": "^1.5.0",
		"pixi.js": "^8.8.1",
		"yocto-queue": "^1.2.0"
	}
}
