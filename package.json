    "@swc/core": "^1.10.16",
    "@types/fs-extra": "^11.0.4",
    "@types/twine-sugarcube": "^2.37.2",
    "browserslist": "^4.24.4",
    "cross-env": "^7.0.3",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.0",
    "hono": "^4.7.1",
    "lightningcss": "^1.29.1",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
