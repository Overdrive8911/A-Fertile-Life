  // Place your snippets for twee3-sugarcube-2 here. Each snippet is defined under a snippet name and has a prefix, body and
  // description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the
  // same ids are connected.
  // Example:
  // "Print to console": {
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }

  // numberpool_macro_set MACROS
  "Macro: numberinput": {
    "prefix": ":numberinput",
    "body": [
      "<<numberinput \"${1:receiverName}\" ${2:defaultValue} ${3:minValue} ${4:maxValue}>>"
    ],
    "description": "Creates a whole number input box, used to modify the value of the $variable with the given name."
  },
  "Macro: numberpool": {
    "prefix": ":numberpool",
    "body": [
      "<<numberpool \"${1:receiverName}\">>\n${2:content}\n<</numberpool>>"
    ],
    "description": "Creates a number pool for use with the other macros from this set. Only useful when paired with them."
  },
  "Macro: numberslider": {
    "prefix": ":numberslider",
    "body": [
      "<<numberslider \"${1:receiverName}\" ${2:defaultValue} ${3:minValue} ${4:maxValue} ${5:stepValue}>>"
    ],
    "description": "Creates a number range slider, used to modify the value of the $variable with the given name."
  },

  // CTP (click-to-proceed)
  "Macro: clicktoproceed": {
    "prefix": [":ctp", ":clicktoproceed"],
    "body": ["<<ctp ${1:id}>>\n${2:content}\n<</ctp>>"],
    "description": "The main CTP macro inside which all content is written."
  },
  "Macro: clicktoproceed_next": {
    "prefix": [":ctpNext"],
    "body": ["<<ctpNext>>"],
    "description": "To be used inside `<<ctp>>` to separate the content into blocks."
  },
  "Macro: clicktoproceed_advance": {
    "prefix": [":ctpAdvance"],
    "body": ["<<ctpAdvance ${1:id}>>"],
    "description": "The 'proceed' part of Click To Proceed... Used to move the train forward and show the next blocks."
  },
  "Macro: clicktoproceed_back": {
    "prefix": [":ctpBack"],
    "body": ["<<ctpBack ${1:id}>>"],
    "description": "Turns back time and goes back one block."
  },

  /* Live Update */
  "Macro: live": {
    "prefix": [":live"],
    "body": ["<<live $1>>"],
    "description": "Similar to <<print>> but allows the variable printed by this macro to be updated by the <<update>> macro."
  },
  "Macro: live (l)": {
    "prefix": [":l"],
    "body": ["<<l $1>>"],
    "description": "Similar to <<=>> but allows the variable printed by this macro to be updated by the <<update>> macro."
  },
  "Macro: live (HTML)": {
    "prefix": [":lh"],
    "body": ["<<lh $1>>"],
    "description": "Similar to <<->> but allows the variable printed by this macro to be updated by the <<update>> macro. Encodes special html characters in its output."
  },
  "Macro: liveblock": {
    "prefix": [":liveblock"],
    "body": ["<<liveblock>>\n${1:content}\n<</liveblock>>"],
    "description": "Creates a block in which variables included in the block can be updated at once by the <<update>> macro."
  },
  "Macro: liveblock (lb)": {
    "prefix": [":lb"],
    "body": ["<<lb>>\n${1:content}\n<</lb>>"],
    "description": "Creates a block in which variables included in the block can be updated at once by the <<update>> macro."
  },
  "Macro: update": {
    "prefix": [":update"],
    "body": ["<<update>>"],
    "description": "Triggers the a synthetic event `:liveupdate` to update the live displays created using the <<live>> or <<liveblock>> macro."
  },
  "Macro: update (upd)": {
    "prefix": [":upd"],
    "body": ["<<upd>>"],
    "description": "Triggers the a synthetic event `:liveupdate` to update the live displays created using the <<live>> or <<liveblock>> macro."
  },

  /* nosp (No space) macro */
  "Macro: nosp": {
    "prefix": [":nosp", ":nospace"],
    "body": ["<<nosp>>\n$1\n<</nosp>>"],
    "description": "Functionally similar to <<nobr>> but also removes whitespaces."
  },

  /* checkvars macro */
  "Macro: checkvars": {
    "prefix": [":checkvars"],
    "body": ["<<checkvars>>"],
    "description": "Creates and opens a debugging dialog which displays the current state of the story's $variable store (State.variables)."
  },

