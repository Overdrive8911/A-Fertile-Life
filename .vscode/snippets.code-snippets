  // MY MACROS
  "MyMacro: updateGameTime": {
    "prefix": [":updateGameTime"],
    "body": ["<<updateGameTime ${1:day(s)} ${2:hour(s)} ${3:minute(s)}>>"],
    "description": "<<updateGameTime 'nextDay' 7 30>> to skip to 7:30 am on the next day or <<updateGameTime 21 15 21>> to skip to 3:21 pm 21 days forwards. Easy enough?"
  },
  "MyMacro: skipTime": {
    "prefix": [":skipTime"],
    "body": ["<<skipTime ${1:day(s)} ${2:hour(s)} ${3:minute(s)}>>"],
    "description": ""
  },
  "MyMacro: impregnate": {
    "prefix": [":impregnate"],
    "body": [
      "<<impregnate ${1:virility} ${2:virilityBonus} ${3:targetWombVariable} ${4:(optional) numberOfFetusesToSpawn}>>"
    ],
    "description": ""
  },
  "MyMacro: updatePregnancy": {
    "prefix": [":updatePregnancy"],
    "body": ["<<updatePregnancy ${1:targetWombVariable}>>"],
    "description": ""
  },
  "MyMacro: isPregBellySizeInRange": {
    "prefix": [":isPregBellySizeInRange"],
    "body": [
      "<<isPregBellySizeInRange ${1:wombInstance} ${2:varToStoreBooleanResult} ${3:lowerLimit_e.g_\"EARLY_PREGNANCY\"} ${3:upperLimit_e.g_\"LATE_PREGNANCY\"}>>"
    ],
    "description": ""
  },
  "MyMacro: giveItem": {
    "prefix": [":giveItem", ":addItem"],
    "body": ["<<giveItem ${1:itemId} ${2:amount(optional)}>>"],
    "description": "<<giveItem FOOD_CHEESE>> adds 1 cheese to the player's inventory\n\n<<giveItem FOOD_CHEESE 7>> adds 7 cheese to the player's inventory\n\nItems can be found in `gInGameItems`.Easy enough?"
  },
  "MyMacro: deleteItem": {
    "prefix": [":deleteItem", ":removeItem"],
    "body": ["<<deleteItem ${1:itemId} ${2:amount(optional)}>>"],
    "description": "<<deleteItem FOOD_CHEESE>> removes 1 cheese from the player's inventory\n\n<<deleteItem FOOD_CHEESE 7>> removes 7 cheese from the player's inventory\n\nItems can be found in `gInGameItems`.Easy enough?"
  },
  "MyMacro: startScene": {
    "prefix": [":startScene"],
    "body": ["<<startScene '${1:passageForScene}'>>"]
  },
  "MyMacro: endScene": {
    "prefix": [":endScene"],
    "body": ["<<endScene '${1:passageForAreaToWarpTo}'>>"]
  },
  "MyMacro: pauseScene": {
    "prefix": [":pauseScene"],
    "body": ["<<pauseScene '${1:passageForAreaToWarpTo}'>>"]
  },
  "MyMacro: cancelScene": {
    "prefix": [":cancelScene"],
    "body": ["<<cancelScene '${1:passageForAreaToWarpTo}'>>"]
  },
  "MyMacro: warp": {
    "prefix": [":warp"],
    "body": ["<<warp '${1:passageForAreaToWarpTo}'>>"]
  },

  /* WIDGETS. I use :: in their prefixes */
  "Widget: playerName": {
    "prefix": ["::pc", "::pcName", "::player", "::playerName"],
    "body": ["<<PC>>"],
    "description": "Gets the first name from the variable $player.name and wraps it in a player name specific class."
  },
  "Widget: changePCPersonality": {
    "prefix": ["::changePCPersonality"],
    "body": ["<<changePCPersonality \"${1:personality}\" ${2:value}>>"],
    "description": "This widget will be used to increment or decrement the PC's personality as well as also increasing and decreasing other personality values depending on some situations."
  },
  "Widget: changePCRelationship": {
    "prefix": ["::changePCRelationship"],
    "body": ["<<changePCRelationship \"${1:character}\" ${2:value}>>"],
    "description": "This widget is used to change the relationship value between the player and another character. If the relationship does not exist, it automatically adds it."
  },
  "Widget: updatePlayerStats": {
    "prefix": ["::updatePlayerStats"],
    "body": ["<<updatePlayerStats>>"],
    "description": "Updates all the player's stats at once."
  },
  "Widget: character": {
    "prefix": [":char", ":character"],
    "body": [
      "<<character \"${1:name}\" \"${2:nameOfClassForTheColorToUse}\" \"${3:value}\">>\n\t$4\n<</character>>"
    ],
    "description": ""
  },
  "Widget: meter": {
    "prefix": ["::meter"],
    "body": ["<<meter \"${1:variableNameOrValue}\">>"],
    "description": ""
  },
  "Widget: startSceneLink": {
    "prefix": "::startSceneLink",
    "body": ["<<startSceneLink \"${1:linkText}\" '${2:passageName}'>>"]
  },
  "Widget: endSceneLink": {
    "prefix": ["::endSceneLink"],
    "body": ["<<endSceneLink \"${1:linkText}\" '${2:passageName}'>>"]
  },
  "Widget: pauseSceneLink": {
    "prefix": ["::pauseSceneLink"],
    "body": ["<<pauseSceneLink \"${1:linkText}\" '${2:passageName}'>>"]
  },
  "Widget: cancelSceneLink": {
    "prefix": ["::cancelSceneLink"],
    "body": ["<<cancelSceneLink \"${1:linkText}\" '${2:passageName}'>>"]
  },
  "Widget: progressScene": {
    "prefix": ["::progressScene"],
    "body": [
      "<<progressScene \"${1:linkText}\" '${2:passageName}' '${3:passageNameToChangeTheCurrentArea}'>>"
    ]
  },

  // My own snippets to make things faster
  "Quick Paragragh": {
    "prefix": ["<p>", "p"],
    "body": ["<p>\n\t$1\n</p>"],
    "description": ""
  },
  "Quick Span + Class": {
    "prefix": ["<span>", "span"],
    "body": ["<span class=\"$1\">\n\t“$2”\n</span>"],
    "description": ""
  },
  "Quick Span + Class (femaleSpeech)": {
    "prefix": ["femaleSpeech"],
    "body": ["<span class=\"femaleSpeech\">\n\t“$1”\n</span>"],
    "description": ""
  },
  "G.I.G.I Speech": {
    "prefix": ["gigi", "g.i.g.i"],
    "body": [
      "<<character \"G.I.G.I\" \"roboSpeech\" \"default\">>\n\t“$1”\n<</character>>"
    ],
    "description": ""
  }
}
