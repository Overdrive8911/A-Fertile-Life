#!/bin/bash
set -euo pipefail

# Configuration
readonly transpiledJsDir="src/scripts/built_js"
readonly compiledCssDir="src/styles/built_css"
readonly buildMode=${1:-""}

clean_directories() {
  local dirs=("$transpiledJsDir" "$compiledCssDir")
  for dir in "${dirs[@]}"; do
    if [[ -d "$dir" ]]; then
      echo "Removing directory: ${dir}"
      rm -rf "$dir"
    else
      echo "Directory not found: ${dir}"
    fi
  done
}

compile_assets() {
  # Compile Sass and TypeScript in parallel
  local sass_pid tsc_pid

  sass src/styles/scss:"$compiledCssDir" --no-source-map --style=compressed && echo "CSS files rebuilt" &
  sass_pid=$!

  tsc --target es2019 --rootDir src/scripts/ts --outDir "$transpiledJsDir" && echo "JS files rebuilt" &
  tsc_pid=$!

  # Wait for both compilations to complete
  wait "$sass_pid" "$tsc_pid"
}

build_project() {
  node build.js
  tweego -o dist/index.html -m src/modules/ --head="src/head-content.html" project "$buildMode"
}

main() {
  clean_directories
  compile_assets
  build_project
}

main
